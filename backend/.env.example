# Copia este archivo como .env y llena tus datos. El .env NO se sube a git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Inventarios

# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
IMHOTEP_SECRET_KEY=

# Bot de alertas de Telegram (opcional). El token lo da @BotFather: NUNCA lo subas a git.
TELEGRAM_BOT_TOKEN=
# Id del grupo: agrega el bot al grupo, escribe /start y corre  python telegram_alertas.py --grupos
TELEGRAM_CHAT_ID=
TELEGRAM_HORA_RESUMEN=08:00

# 1 = recarga sola al guardar y muestra errores detallados. NUNCA en el servidor.
FLASK_DEBUG=1
